/tokenizers/
*.safetensors

# Harness raw output (summaries go in docs/results/)
/harness/out/
/build/

# Local code-graph cache
/graphify-out/

# Local Claude settings
.claude/

# OS / editor
.DS_Store
.idea/
.vscode/

# Claude Code worktrees (parallel builds)
.claude/worktrees/
.mcp.json

# Python bytecode caches
__pycache__/
*.pyc
