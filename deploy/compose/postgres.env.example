# Postgres credentials. `make compose-env` copies this to postgres.env
# (gitignored). Change the password in the copy for anything but local dev.
# Postgres is published on 127.0.0.1 only (POSTGRES_HOST_PORT, default 5433);
# the gateways reach it on the Compose network.
POSTGRES_USER=gateway
POSTGRES_DB=gateway
POSTGRES_PASSWORD=change-me-local-dev-only
