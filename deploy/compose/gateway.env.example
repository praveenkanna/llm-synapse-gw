# Gateway secrets. `make compose-env` copies this to gateway.env (gitignored);
# put real values only in the copy. Empty values count as unset.

# Caller bearer tokens (>= 16 chars, no whitespace, unique), referenced by
# token_env in config/gateway.gpu.yaml. Unused by the dev profile, whose
# config/gateway.dev.yaml disables auth.
GATEWAY_TOKEN_CHAT_SERVICE=
GATEWAY_TOKEN_BATCH_SERVICE=

# Key the gateway sends upstream. Must equal VLLM_API_KEY in vllm.env when vLLM
# runs with a key; leave empty otherwise.
GATEWAY_UPSTREAM_API_KEY=

# Template registry (M3). The DSN holds the Postgres password. Leave it empty
# here: `make compose-env` (and CI) build it in the gitignored copy from
# postgres.env (scripts/compose-secrets.sh), so the two agree. Empty turns the
# registry and admin API off; the request path works either way. For a gpu
# stack set your own.
GATEWAY_TEMPLATES_POSTGRES_DSN=

# Admin API bearer token (>= 16 chars, not a caller token), referenced by
# admin.tokens in the gateway config. Required once the DSN is set: the
# gateway refuses to start with the DSN set and this empty. Leave it empty
# here: the same script puts a random token in the copy; read it there to
# call the admin API. For a gpu stack set your own.
GATEWAY_ADMIN_TOKEN_PROMPT_OWNERS=

# Any other GATEWAY_* override from config/gateway.example.yaml may go here too.
