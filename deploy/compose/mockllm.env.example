# mockllm knobs for the dev profile. `make compose-env` copies this to
# mockllm.env (gitignored), which both mockllm services read. Values below are
# the built-in defaults; uncomment to change. Per-request overrides:
# X-Mock-Fault, X-Mock-Output-Tokens, X-Mock-TTFT-Ms headers. Connection refusal:
# POST /mock/refuse?for=DURATION on the replica (published on localhost, see
# MOCKLLM_HOST_PORT in docker-compose.yml).
#
# MOCKLLM_LISTEN_ADDR and MOCKLLM_MODELS are set per service in
# docker-compose.yml (they must match config/gateway.dev.yaml) and override
# anything here, as do MOCKLLM_MAX_NUM_SEQS and MOCKLLM_SCHEDULING_POLICY of the
# large mockllm (MOCKLLM_LARGE_* variables there).

# Time to first token, Go duration.
# MOCKLLM_TTFT=50ms
# Decode rate per request; <= 0 for no delay.
# MOCKLLM_TOKENS_PER_SECOND=50
# Output length: fixed:N | uniform:MIN:MAX | normal:MEAN:STDDEV
# MOCKLLM_OUTPUT_TOKENS=uniform:16:128
# Context length reported and enforced.
# MOCKLLM_MAX_MODEL_LEN=8192
# Concurrent running requests (like vLLM --max-num-seqs); 0 = unlimited.
# MOCKLLM_MAX_NUM_SEQS=0
# Like vLLM --scheduling-policy: fcfs | priority. fcfs rejects a non-zero
# request "priority" with 400; priority admits waiting requests lowest
# "priority" value first (needs MOCKLLM_MAX_NUM_SEQS > 0 to queue anything).
# MOCKLLM_SCHEDULING_POLICY=fcfs
# Prefix-cache emulation (vLLM automatic prefix caching over the stand-in
# tokenizer: 4-byte tokens, 16-token blocks): per-model capacity in blocks,
# least recently used evicted first; 0 = off (prefix_cache_hits stay 0).
# POST /reset_prefix_cache (with the control endpoints on) empties it.
# MOCKLLM_PREFIX_CACHE_BLOCKS=32768

# Fault injection probabilities (0..1).
# MOCKLLM_FAULT_5XX_RATE=0
# MOCKLLM_FAULT_DROP_RATE=0
# MOCKLLM_FAULT_HANG_RATE=0
# MOCKLLM_FAULT_STALL_RATE=0
# Status used by the 5xx fault.
# MOCKLLM_ERROR_STATUS=500

# Received requests kept for GET /mock/requests (0 = off) and body bytes kept each.
# MOCKLLM_CAPTURE_ENTRIES=64
# MOCKLLM_CAPTURE_MAX_BYTES=262144
# Request body limit; larger gets 413.
# MOCKLLM_MAX_BODY_BYTES=8388608
# Serve the /mock/ control endpoints.
# MOCKLLM_CONTROL_ENABLED=true
# Sampling seed; 0 = random.
# MOCKLLM_SEED=0

# vLLM release family to imitate (ADR 0011): current | legacy.
#   current: errors {"error":{...}}; metrics vllm:kv_cache_usage_perc,
#            vllm:prefix_cache_queries_total, vllm:prefix_cache_hits_total
#   legacy:  errors {"object":"error",...}; metrics vllm:gpu_cache_usage_perc,
#            vllm:gpu_prefix_cache_queries_total, vllm:gpu_prefix_cache_hits_total
# MOCKLLM_VLLM_COMPAT=current
