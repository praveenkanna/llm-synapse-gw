# vLLM secrets for the gpu profile. `make compose-env` copies this to vllm.env
# (gitignored). Empty values count as unset.

# Hugging Face token for gated model downloads.
HF_TOKEN=
# If set, vLLM requires this key on /v1 routes; set the same value as
# GATEWAY_UPSTREAM_API_KEY in gateway.env.
VLLM_API_KEY=
