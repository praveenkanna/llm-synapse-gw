# ==============================================================================
# LLM Synapse Gateway (.env.example)
#
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
#
# Note: For Docker Compose, run `make compose-env` which generates the
# multi-container env files in deploy/compose/.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION
# ------------------------------------------------------------------------------

# Path to the gateway YAML configuration file (relative or absolute).
# Example configs:
#   - deploy/compose/config/gateway.dev.yaml     (mock LLM for local GPU-less testing)
#   - deploy/compose/config/gateway.gpu.yaml     (live vLLM / SGLang / Ollama GPU cluster)
#   - deploy/compose/config/gateway.example.yaml (complete annotated reference)
GATEWAY_CONFIG=deploy/compose/config/gateway.dev.yaml

# Address and port where the gateway listens for OpenAI-compatible client requests (/v1/*).
GATEWAY_LISTEN_ADDR=127.0.0.1:8080

# Address and port where Prometheus metrics are exposed (/metrics).
GATEWAY_METRICS_LISTEN_ADDR=127.0.0.1:9090

# Default backend pool name when an incoming request doesn't match an explicit model mapping.
GATEWAY_DEFAULT_POOL=large-pool

# Maximum allowable request body size in bytes (e.g. 16MB for large context prompts).
GATEWAY_MAX_REQUEST_BODY_BYTES=16777216

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------

# Require callers to provide an OpenAI Bearer token (Authorization: Bearer <token>).
# Set to 'false' for local development; 'true' for production.
GATEWAY_AUTH_ENABLED=false

# API Key forwarded to upstream GPU backends (vLLM, RunPod, etc.) if they require auth.
# Leave empty if upstream does not require an API key.
GATEWAY_UPSTREAM_API_KEY=

# Example caller tokens (minimum 16 chars). Referenced by token_env in gateway.yaml.
GATEWAY_TOKEN_CHAT_SERVICE=sk-synapse-chat-service-secret-token-12345
GATEWAY_TOKEN_BATCH_SERVICE=sk-synapse-batch-service-secret-token-67890

# ------------------------------------------------------------------------------
# 3. UPSTREAM CONNECTION POOLING & WAN OPTIMIZATION
# ------------------------------------------------------------------------------

# Max idle keep-alive connections maintained per backend replica host.
GATEWAY_UPSTREAM_MAX_IDLE_CONNS_PER_HOST=64

# Keep-alive connection idle timeout (e.g. 90s keeps connections warm across bursts).
GATEWAY_UPSTREAM_IDLE_CONN_TIMEOUT=90s

# Enable HTTP/2 connection multiplexing to upstream replicas.
GATEWAY_UPSTREAM_ENABLE_HTTP2=false

# Timeout waiting for the first byte/chunk of response from upstream.
GATEWAY_UPSTREAM_FIRST_CHUNK_TIMEOUT=30s

# Timeout between consecutive streaming chunks before considering the engine stuck.
GATEWAY_UPSTREAM_IDLE_BETWEEN_CHUNKS_TIMEOUT=60s

# ------------------------------------------------------------------------------
# 4. REQUEST COALESCING (IN-FLIGHT SINGLEFLIGHT)
# ------------------------------------------------------------------------------

# Maximum concurrent unique prompts being coalesced simultaneously.
GATEWAY_COALESCING_MAX_FLIGHTS=256

# Maximum number of concurrent subscriber clients that can join a single in-flight flight.
GATEWAY_COALESCING_MAX_SUBSCRIBERS=64

# Maximum buffer size stored per flight to catch up late-joining follower streams.
GATEWAY_COALESCING_MAX_REPLAY_BYTES=65536

# ------------------------------------------------------------------------------
# 5. KV-CACHE & RESPONSE CACHING (OPTIONAL REDIS)
# ------------------------------------------------------------------------------

# Enable caching of completed responses.
GATEWAY_CACHE_ENABLED=false

# Redis host:port for shared cache state.
GATEWAY_CACHE_REDIS_ADDR=127.0.0.1:6379
GATEWAY_CACHE_REDIS_PASSWORD=

# Maximum time-to-live for cached responses.
GATEWAY_CACHE_MAX_TTL=3600s

# ------------------------------------------------------------------------------
# 6. ADMISSION CONTROL & OVERLOAD PROTECTION (TTFT SHEDDING)
# ------------------------------------------------------------------------------

# Enable priority queues and request admission control.
GATEWAY_ADMISSION_ENABLED=true

# Maximum queue length per priority class before shedding new requests with 429.
GATEWAY_ADMISSION_MAX_QUEUE=1000

# Maximum duration a request can wait in queue before timing out (504).
GATEWAY_ADMISSION_MAX_WAIT=30s

# Enable dynamic traffic shedding when downstream GPU Time-To-First-Token degrades.
GATEWAY_ADMISSION_SHED_ENABLED=true

# P95 TTFT threshold that triggers shedding of low-priority / background requests.
GATEWAY_ADMISSION_SHED_TTFT_P95_THRESHOLD=5s

# ------------------------------------------------------------------------------
# 7. PROMPT TEMPLATES & ADMIN API (OPTIONAL POSTGRES)
# ------------------------------------------------------------------------------

# Postgres connection DSN for multi-tenant prompt template storage.
# Leave empty to run without database/admin templates.
GATEWAY_TEMPLATES_POSTGRES_DSN=

# Admin API listen address for managing prompt templates (never exposed publicly).
GATEWAY_ADMIN_LISTEN_ADDR=127.0.0.1:8081

# Bearer token for accessing the Admin API (>= 16 chars).
GATEWAY_ADMIN_TOKEN_PROMPT_OWNERS=admin-secret-token-change-in-production

